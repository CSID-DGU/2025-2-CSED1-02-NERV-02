{
  "manifest_version": 3,
  "name": "GuardFilter",
  "version": "1.0.0",
  "description": "Real-time analysis and blocking of chat messages.",
  "icons": {
    "16": "icons/GuardFilterLogo_16.png",
    "32": "icons/GuardFilterLogo_32.png",
    "48": "icons/GuardFilterLogo_48.png",
    "128": "icons/GuardFilterLogo_128.png"
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_title": "GuardFilter Settings",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/GuardFilterLogo_16.png",
      "32": "icons/GuardFilterLogo_32.png",
      "48": "icons/GuardFilterLogo_48.png",
      "128": "icons/GuardFilterLogo_128.png"
    }
  },

  "permissions": [
    "storage", 
    "tabs",
    "activeTab",
    "scripting"
  ],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src http://localhost:8000 http://127.0.0.1:8000"
  },
  
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ]
}